# AVA V0 — local development configuration
# Copy to .env.local. Never commit real values.

# Storage mode:
#   pglite   embedded PostgreSQL, no external service (default)
#   server   external PostgreSQL, requires DATABASE_URL
AVA_DB_MODE=pglite

# Local data directory used when AVA_DB_MODE=pglite
AVA_PGLITE_DIR=.pgdata

# Used only when AVA_DB_MODE=server (see docker-compose.yml)
# DATABASE_URL=postgres://ava:ava@localhost:55432/ava

# --- Model provider ---------------------------------------------------------
# ADR-22 provider gate is OPEN. The mock provider is the only registered
# provider. No external provider may be configured until S3-T15 closes.
AVA_MODEL_PROVIDER=mock

# --- Operational safety caps (ADR-21) ---------------------------------------
# IMPLEMENTATION CONFIG REQUIRED BEFORE FIRST REAL MODEL CALL.
# Intentionally unset. These are OPERATIONAL SAFETY CAPS, not product
# validation thresholds. Leaving them unset keeps the budget controller
# closed: with no cap configured, no external call may be authorised.
# AVA_CAP_PER_CALL_USD=
# AVA_CAP_PER_CHECKPOINT_USD=
# AVA_CAP_DAILY_USD=
# AVA_CAP_MONTHLY_USD=
# AVA_CAP_RETRIES=
