# AVA V0 — local development configuration
# Copy to .env.local. Never commit real values.

# --- Storage ----------------------------------------------------------------
# pglite   embedded PostgreSQL, no external service (default)
# server   external PostgreSQL, requires DATABASE_URL
AVA_DB_MODE=pglite
AVA_PGLITE_DIR=.pgdata
# DATABASE_URL=postgres://ava:ava@localhost:55432/ava

# --- Model provider (ADR-22) ------------------------------------------------
# mock       MockModelProvider only; nothing leaves the process (default)
# anthropic  initial V0 implementation provider
#
# Selecting a provider is not enough to execute: it must also be registered,
# configured and explicitly enabled by the provider registry.
AVA_MODEL_PROVIDER=mock
AVA_MODEL_NAME=claude-sonnet-5

# Never commit this value.
ANTHROPIC_API_KEY=

# --- Operational safety caps (ADR-21 Gate A) --------------------------------
# OPERATIONAL SAFETY CAPS, not product validation thresholds. A cap being hit
# means the limit worked; it says nothing about whether the product passed the
# economic gate. Gate B remains open.
#
# With no cap configured the budget controller is CLOSED, so no external call
# is authorised.
AVA_CAP_PER_CALL_USD=0.15
AVA_CAP_PER_CHECKPOINT_USD=0.50
AVA_CAP_DAILY_USD=2.00
AVA_CAP_MONTHLY_USD=20.00
AVA_CAP_RETRIES=1

# --- Logging ----------------------------------------------------------------
# Local only, redacted, off by default. No external observability exporter.
AVA_LOG=0
